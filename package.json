{
  "name": "gitchess",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "npm run build && node dist/server.js",
    "setup": "npm run build && bash scripts/setup-host-key.sh && bash scripts/setup-repo.sh && bash scripts/setup-bot.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.6",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "ssh2": "^1.17.0"
  }
}
